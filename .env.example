# Copy to .env and fill in. Never commit .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: signs cookies and encrypts stored tokens. If empty, a random key is
# generated once and stored in .codeatlas-data/secret.key
SECRET_KEY=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Set true only when served over HTTPS
COOKIE_SECURE=false

# Optional limits
# WORKSPACE_DIR=./.codeatlas-data
# MAX_FILE_BYTES=1000000
# MAX_FILES=20000
